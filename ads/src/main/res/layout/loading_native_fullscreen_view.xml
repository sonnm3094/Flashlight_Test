<?xml version="1.0" encoding="utf-8"?>
<com.facebook.shimmer.ShimmerFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/shimmerContainerNative"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:visibility="visible"
    app:layout_constraintTop_toTopOf="parent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <View
            android:id="@+id/cta"
            android:layout_width="match_parent"
            android:layout_height="@dimen/size48"
            android:layout_marginHorizontal="@dimen/size10"
            android:layout_marginBottom="@dimen/size10"
            android:background="@color/home_shimmer_color"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/icon"
            app:layout_constraintHeight_min="@dimen/size40"
            app:layout_constraintStart_toStartOf="parent" />

        <View
            android:id="@+id/media_view"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginBottom="@dimen/size20"
            android:background="@color/home_shimmer_color"
            app:layout_constraintBottom_toTopOf="@+id/icon"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <View
            android:id="@+id/icon"
            android:layout_width="@dimen/size56"
            android:layout_height="@dimen/size56"
            android:layout_marginStart="@dimen/size10"
            android:layout_marginBottom="@dimen/size10"
            android:background="@color/home_shimmer_color"
            app:layout_constraintBottom_toTopOf="@+id/cta"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/media_view"
            tools:src="@tools:sample/avatars" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/appCompatTextView"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/size20"
            android:layout_marginStart="@dimen/size10"
            android:background="@drawable/shape_ad_view"
            android:backgroundTint="@color/home_shimmer_color"
            android:gravity="center"
            android:paddingHorizontal="@dimen/size5"
            android:text="Ad"
            android:textColor="@color/gnt_white"
            android:textSize="12dp"
            android:textStyle="bold"
            app:layout_constraintStart_toEndOf="@+id/icon"
            app:layout_constraintTop_toTopOf="@+id/icon" />

        <View
            android:id="@+id/secondary"
            android:layout_width="0dp"
            android:layout_height="@dimen/size30"
            android:layout_marginTop="@dimen/size5"
            android:background="@color/home_shimmer_color"
            android:visibility="visible"
            app:layout_constraintEnd_toEndOf="@+id/cta"
            app:layout_constraintStart_toStartOf="@+id/appCompatTextView"
            app:layout_constraintTop_toBottomOf="@+id/appCompatTextView" />

        <View
            android:id="@+id/primary"
            android:layout_width="0dp"
            android:layout_height="@dimen/size20"
            android:layout_marginStart="@dimen/size5"
            android:layout_marginEnd="@dimen/size10"
            android:background="@color/home_shimmer_color"
            android:textColor="@color/gnt_gray"
            android:textSize="@dimen/size15"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@+id/appCompatTextView"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/appCompatTextView"
            app:layout_constraintTop_toTopOf="@+id/icon" />


    </androidx.constraintlayout.widget.ConstraintLayout>
</com.facebook.shimmer.ShimmerFrameLayout>
