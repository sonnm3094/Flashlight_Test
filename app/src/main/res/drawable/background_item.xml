<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <solid android:color="@color/color_card_dark_cc"/>
            <stroke android:color="@color/divider" android:width="@dimen/size1"/>
            <corners android:radius="@dimen/size44"/>
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/color_card_dark"/>
            <stroke android:color="@color/divider" android:width="@dimen/size1"/>
            <corners android:radius="@dimen/size44"/>
        </shape>
    </item>
</selector>
