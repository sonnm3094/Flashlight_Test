<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/white_20_percent">
    <item>
        <selector>
            <item android:state_selected="true">
                <shape>
                    <solid android:color="@color/color_item_language_bg" />
                    <corners android:radius="14dp" />
                    <stroke android:width="1dp" android:color="@color/color_item_language_border" />
                </shape>
            </item>
            <item android:state_pressed="true">
                <shape>
                    <solid android:color="@color/color_item_language_pressed" />
                    <corners android:radius="14dp" />
                </shape>
            </item>
            <item>
                <shape>
                    <solid android:color="@color/color_item_language_bg" />
                    <corners android:radius="14dp" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
