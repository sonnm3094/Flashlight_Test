<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/white_20_percent">
    <item>
        <selector>
            <item android:state_pressed="true">
                <shape>
                    <solid android:color="@color/color_box_background" />
                    <stroke
                        android:width="1.5dp"
                        android:color="@color/color_box_border" />
                    <corners android:radius="12dp" />
                </shape>
            </item>
            <item>
                <shape>
                    <solid android:color="@color/color_box_background_pressed" />
                    <stroke
                        android:width="1.5dp"
                        android:color="@color/color_box_border" />
                    <corners android:radius="12dp" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
