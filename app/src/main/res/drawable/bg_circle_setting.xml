<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/white_25_percent">
    <item>
        <selector>
            <item android:state_pressed="true">
                <shape android:shape="oval">
                    <solid android:color="@color/color_circle_setting_pressed" />
                </shape>
            </item>
            <item>
                <shape android:shape="oval">
                    <solid android:color="@color/color_circle_setting_bg" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
