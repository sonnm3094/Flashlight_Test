<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/white_25_percent">
    <item>
        <selector>
            <item android:state_pressed="true">
                <shape>
                    <solid android:color="@color/color_yellow_dark"/>
                    <corners android:radius="@dimen/size12" />
                </shape>
            </item>
            <item>
                <shape>
                    <gradient android:startColor="@color/color_yellow_accent" android:endColor="@color/color_yellow_dark"/>
                    <corners android:radius="@dimen/size12" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
