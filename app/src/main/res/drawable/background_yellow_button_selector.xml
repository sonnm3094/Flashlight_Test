<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#40FFFFFF">
    <item>
        <selector>
            <item android:state_pressed="true">
                <shape>
                    <solid android:color="#D79B1D"/>
                    <corners android:radius="@dimen/size12" />
                </shape>
            </item>
            <item>
                <shape>
                    <gradient android:startColor="#FFC81A" android:endColor="#D79B1D"/>
                    <corners android:radius="@dimen/size12" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
