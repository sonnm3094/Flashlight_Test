<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/color_yellow_mode_border">
    <item>
        <selector>
            <item android:state_pressed="true">
                <shape>
                    <solid android:color="@color/color_mode_card_selected" />
                    <corners android:radius="12dp" />
                    <stroke
                        android:width="1.5dp"
                        android:color="@color/color_main" />
                </shape>
            </item>
            <item>
                <shape>
                    <solid android:color="@color/color_mode_card_selected_pressed" />
                    <corners android:radius="12dp" />
                    <stroke
                        android:width="1.5dp"
                        android:color="@color/color_main" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
