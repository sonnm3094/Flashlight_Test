<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#33FACE15">
    <item>
        <selector>
            <item android:state_pressed="true">
                <shape>
                    <solid android:color="#262A35" />
                    <corners android:radius="12dp" />
                    <stroke
                        android:width="1.5dp"
                        android:color="@color/color_main" />
                </shape>
            </item>
            <item>
                <shape>
                    <solid android:color="#1A1D24" />
                    <corners android:radius="12dp" />
                    <stroke
                        android:width="1.5dp"
                        android:color="@color/color_main" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
