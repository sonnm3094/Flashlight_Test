<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="StyleYellowButton" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/size44</item>
        <item name="android:layout_marginStart">@dimen/size15</item>
        <item name="android:layout_marginEnd">@dimen/size15</item>
        <item name="android:background">@drawable/background_yellow_button_selector</item>
        <item name="android:textSize">@dimen/size16</item>
        <item name="android:gravity">center</item>
        <item name="fontFamily">@font/plus_jakarta_sans_regular</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="StylePrimaryButton" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:background">@drawable/background_yellow_button_selector</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:gravity">center</item>
        <item name="fontFamily">@font/plus_jakarta_sans_bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="StylePurpleButton" parent="StyleYellowButton" />

    <style name="StyleTransparentButton" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/size44</item>
        <item name="android:layout_marginStart">@dimen/size15</item>
        <item name="android:layout_marginEnd">@dimen/size15</item>
        <item name="android:background">@drawable/background_transparent_selector</item>
        <item name="android:textSize">@dimen/size16</item>
        <item name="android:gravity">center</item>
        <item name="fontFamily">@font/plus_jakarta_sans_regular</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/text_main</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="Widget.App.TextView" parent="Widget.AppCompat.TextView">
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="CustomProgressLoading" parent="@android:style/Theme.Dialog">
        <item name="android:windowFrame">@null</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.Dialog</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
    </style>
    <style name="Theme.Dialog" parent="Theme.MaterialComponents.Light.Dialog">
        <item name="android:windowBackground">@color/transparent_50</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowMinWidthMajor">90%</item>
        <item name="android:windowMinWidthMinor">90%</item>
    </style>

    <style name="BottomSheetAnimation">
        <item name="android:windowEnterAnimation">@anim/slide_up</item>
        <item name="android:windowExitAnimation">@anim/slide_down</item>
    </style>

    <style name="ItemSetting" parent="Theme.ShortFilm">
        <item name="android:textColor">@color/text_main</item>
        <item name="android:textSize">@dimen/size16</item>
        <item name="android:paddingStart">@dimen/size15</item>
        <item name="android:layout_marginTop">@dimen/size15</item>
        <item name="android:layout_marginStart">@dimen/size15</item>
        <item name="android:layout_marginEnd">@dimen/size15</item>
        <item name="android:paddingEnd">@dimen/size15</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/size44</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:background">@drawable/background_item</item>
    </style>

    <style name="Widget.App" parent="" />

    <style name="Widget.App.ColorPresetContainer">
        <item name="android:layout_width">44dp</item>
        <item name="android:layout_height">44dp</item>
    </style>

    <style name="Widget.App.ColorPresetRing">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:background">@drawable/bg_color_circle_selected</item>
    </style>

    <style name="Widget.App.ColorPresetCircle">
        <item name="android:layout_width">40dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:layout_gravity">center</item>
        <item name="android:clickable">false</item>
        <item name="android:focusable">false</item>
        <item name="riv_corner_radius">24dp</item>
    </style>

    <style name="Widget.App.PaletteButton">
        <item name="android:layout_width">42dp</item>
        <item name="android:layout_height">42dp</item>
        <item name="android:background">@drawable/bg_palette_button</item>
        <item name="android:clickable">false</item>
        <item name="android:focusable">false</item>
    </style>

    <style name="Widget.App.CardContainer">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:background">@drawable/bg_rectangle_box</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">16dp</item>
    </style>

    <style name="Widget.App.CardBackground">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:background">@drawable/led_selected_border</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">16dp</item>
    </style>

    <style name="Widget.App.CardTitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">16sp</item>
        <item name="fontFamily">@font/plus_jakarta_sans_medium</item>
    </style>

    <style name="Widget.App.FullscreenExpandButton">
        <item name="android:layout_width">38dp</item>
        <item name="android:layout_height">38dp</item>
        <item name="android:layout_gravity">top|end</item>
        <item name="android:layout_margin">12dp</item>
        <item name="android:background">@drawable/bg_expand_button</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:padding">8dp</item>
        <item name="android:src">@drawable/ic_fullscreen</item>
        <item name="tint">@color/color_main</item>
    </style>
</resources>
