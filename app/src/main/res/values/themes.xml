<resources>

    <style name="Base.Theme.ShortFilm" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimaryDark">#FFF4F9</item>
        <item name="android:statusBarColor">#0D0D0D</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowFullscreen">false</item>
        <item name="colorAccent">@color/black</item>
        <item name="android:splitMotionEvents">false</item>
        <item name="android:windowEnableSplitTouch">false</item>
        <item name="android:textViewStyle">@style/Widget.App.TextView</item>
    </style>

    <style name="Theme.ShortFilm" parent="Base.Theme.ShortFilm">
        <item name="fontFamily">@font/plus_jakarta_sans</item>
    </style>

</resources>
