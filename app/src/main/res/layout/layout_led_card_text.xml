<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardText"
    style="@style/Widget.App.CardContainer">

    <TextView
        style="@style/Widget.App.CardTitle"
        android:text="@string/text_label" />

    <androidx.appcompat.widget.AppCompatEditText
        android:id="@+id/etLedText"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_seekbar_progress"
        android:hint="HELLO WORLD"
        android:inputType="textCapCharacters"
        android:paddingHorizontal="16dp"
        android:singleLine="true"
        android:textColor="@color/white"
        android:textColorHint="@color/white_38_percent"
        android:textSize="15sp"
        app:fontFamily="@font/plus_jakarta_sans_medium" />

</LinearLayout>