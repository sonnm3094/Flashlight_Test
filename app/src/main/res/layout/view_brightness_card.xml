<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card_container"
    android:paddingHorizontal="16dp"
    android:paddingVertical="16dp">

    <TextView
        android:id="@+id/tvBrightnessLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/brightness"
        android:textColor="@color/white"
        android:textSize="16sp"
        app:fontFamily="@font/google_sans_medium"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvBrightnessValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#FFC81A"
        android:textSize="16sp"
        android:textStyle="bold"
        app:fontFamily="@font/google_sans_bold"
        app:layout_constraintBottom_toBottomOf="@+id/tvBrightnessLabel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tvBrightnessLabel"
        tools:text="80%" />

    <androidx.appcompat.widget.AppCompatSeekBar
        android:id="@+id/sbBrightness"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:max="100"
        android:maxHeight="6dp"
        android:minHeight="6dp"
        android:paddingStart="@dimen/size12"
        android:paddingEnd="@dimen/size12"
        android:progress="80"
        android:progressDrawable="@drawable/bg_seekbar_progress"
        android:splitTrack="false"
        android:thumb="@drawable/bg_seekbar_thumb"
        android:thumbOffset="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvBrightnessLabel" />

</androidx.constraintlayout.widget.ConstraintLayout>
