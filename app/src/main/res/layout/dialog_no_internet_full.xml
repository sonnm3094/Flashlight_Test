<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121214">

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/imgNoWifi"
        android:layout_width="160dp"
        android:layout_height="160dp"
        android:layout_marginTop="120dp"
        android:adjustViewBounds="true"
        android:scaleType="fitCenter"
        android:background="@drawable/bg_mode_card_unselected"
        android:paddingTop="@dimen/size12"
        android:paddingBottom="@dimen/size12"
        android:paddingStart="@dimen/size12"
        android:paddingEnd="@dimen/size12"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@mipmap/bg_no_wifi" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/size24"
        android:layout_marginTop="@dimen/size24"
        android:gravity="center"
        android:text="@string/connection_lost"
        android:textColor="@color/white"
        android:textSize="20sp"
        android:textStyle="bold"
        app:fontFamily="@font/google_sans_bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/imgNoWifi" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvMessage"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/size32"
        android:layout_marginTop="@dimen/size8"
        android:gravity="center"
        android:lineSpacingExtra="4dp"
        android:text="@string/connection_lost_message"
        android:textColor="#9E9EA4"
        android:textSize="14sp"
        app:fontFamily="@font/google_sans_regular"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvTitle" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnGoToSetting"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:layout_marginHorizontal="@dimen/size24"
        android:layout_marginTop="32dp"
        android:background="@drawable/bg_rectangle_box"
        android:includeFontPadding="false"
        android:text="@string/go_to_setting"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:textStyle="bold"
        app:fontFamily="@font/google_sans_medium"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvMessage" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnCancel"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:layout_marginTop="12dp"
        android:background="@android:color/transparent"
        android:includeFontPadding="false"
        android:minHeight="0dp"
        android:paddingVertical="10dp"
        android:paddingHorizontal="24dp"
        android:text="@string/cancel"
        android:textAllCaps="false"
        android:textColor="#E0E0E0"
        android:textSize="16sp"
        app:fontFamily="@font/google_sans_medium"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btnGoToSetting" />

</androidx.constraintlayout.widget.ConstraintLayout>