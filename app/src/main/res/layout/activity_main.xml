<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_main">

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/fragment_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/llBottomNav"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/llBottomNav"
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:background="#1C1B1B"
        android:baselineAligned="false"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <FrameLayout
            android:id="@+id/flTabFlashlight"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clipChildren="false"
            android:clipToPadding="false">

            <View
                android:id="@+id/vGlowFlashlight"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginHorizontal="0dp"
                android:layout_marginVertical="2dp"
                android:background="@drawable/bg_bottom_nav_glow"
                android:visibility="visible" />

            <LinearLayout
                android:id="@+id/btnTabFlashlight"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginHorizontal="4dp"
                android:layout_marginVertical="6dp"
                android:background="@drawable/bg_bottom_nav_selected"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/imgTabFlashlight"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_flash_light"
                    app:tint="@color/color_main" />

                <TextView
                    android:id="@+id/tvTabFlashlight"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/flashlight"
                    android:textColor="@color/color_main"
                    android:textSize="11sp"
                    app:fontFamily="@font/google_sans_medium" />

            </LinearLayout>

        </FrameLayout>

        <FrameLayout
            android:id="@+id/flTabScreenlight"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clipChildren="false"
            android:clipToPadding="false">

            <View
                android:id="@+id/vGlowScreenlight"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginHorizontal="0dp"
                android:layout_marginVertical="2dp"
                android:background="@drawable/bg_bottom_nav_glow"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/btnTabScreenlight"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginHorizontal="4dp"
                android:layout_marginVertical="6dp"
                android:background="@color/transparent"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/imgTabScreenlight"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_screen_light"
                    app:tint="#80FFFFFF" />

                <TextView
                    android:id="@+id/tvTabScreenlight"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/screenlight"
                    android:textColor="#80FFFFFF"
                    android:textSize="11sp"
                    app:fontFamily="@font/google_sans_medium" />

            </LinearLayout>

        </FrameLayout>

        <FrameLayout
            android:id="@+id/flTabLed"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clipChildren="false"
            android:clipToPadding="false">

            <View
                android:id="@+id/vGlowLed"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginHorizontal="0dp"
                android:layout_marginVertical="2dp"
                android:background="@drawable/bg_bottom_nav_glow"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/btnTabLed"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginHorizontal="4dp"
                android:layout_marginVertical="6dp"
                android:background="@color/transparent"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/imgTabLed"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_led"
                    app:tint="#80FFFFFF" />

                <TextView
                    android:id="@+id/tvTabLed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/led"
                    android:textColor="#80FFFFFF"
                    android:textSize="11sp"
                    app:fontFamily="@font/google_sans_medium" />

            </LinearLayout>

        </FrameLayout>

        <FrameLayout
            android:id="@+id/flTabFlashAlert"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clipChildren="false"
            android:clipToPadding="false">

            <View
                android:id="@+id/vGlowFlashAlert"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginHorizontal="0dp"
                android:layout_marginVertical="2dp"
                android:background="@drawable/bg_bottom_nav_glow"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/btnTabFlashAlert"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginHorizontal="4dp"
                android:layout_marginVertical="6dp"
                android:background="@color/transparent"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/imgTabFlashAlert"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_flash_alert"
                    app:tint="#80FFFFFF" />

                <TextView
                    android:id="@+id/tvTabFlashAlert"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/flash_alert"
                    android:textColor="#80FFFFFF"
                    android:textSize="11sp"
                    app:fontFamily="@font/google_sans_medium" />

            </LinearLayout>

        </FrameLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
