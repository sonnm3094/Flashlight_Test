<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardVisualEffects"
    style="@style/Widget.App.CardContainer">

    <TextView
        style="@style/Widget.App.CardTitle"
        android:text="@string/visual_effects" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnEffectGlow"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_mode_card_selected"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/effect_glow"
            android:textColor="@color/color_main"
            android:textSize="14sp"
            app:fontFamily="@font/google_sans_medium" />

        <TextView
            android:id="@+id/btnEffectBlink"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginHorizontal="3dp"
            android:layout_weight="1"
            android:background="@drawable/bg_mode_card_unselected"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/effect_blink"
            android:textColor="#8C8C8C"
            android:textSize="14sp"
            app:fontFamily="@font/google_sans_medium" />

        <TextView
            android:id="@+id/btnEffectNeon"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_mode_card_unselected"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/effect_neon"
            android:textColor="#8C8C8C"
            android:textSize="14sp"
            app:fontFamily="@font/google_sans_medium" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnEffectFade"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_mode_card_unselected"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/effect_fade"
            android:textColor="#8C8C8C"
            android:textSize="14sp"
            app:fontFamily="@font/google_sans_medium" />

        <View
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginHorizontal="3dp"
            android:layout_weight="1"
            android:visibility="invisible" />

        <View
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:visibility="invisible" />

    </LinearLayout>

</LinearLayout>