<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_main">

    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/btnClose"
        android:layout_width="@dimen/size44"
        android:layout_height="@dimen/size44"
        android:layout_marginStart="@dimen/size15"
        android:layout_marginTop="@dimen/size40"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_close_3"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/appCompatTextView5"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/size10"
        android:text="Native Type 1"
        android:textColor="@color/white"
        android:textSize="@dimen/size16"
        app:layout_constraintBottom_toTopOf="@+id/frAdsNativeType1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <FrameLayout
        android:id="@+id/frAdsNativeType1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/size3"
        android:layout_marginBottom="@dimen/size50"
        app:layout_constraintBottom_toTopOf="@+id/appCompatTextView4">

        <include
            android:id="@+id/shimmerContainerNative1"
            layout="@layout/loading_native_ad_view_type1" />
    </FrameLayout>

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/appCompatTextView4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/size10"
        android:text="Native Type 2"
        android:textColor="@color/white"
        android:textSize="@dimen/size16"
        app:layout_constraintBottom_toTopOf="@+id/frAdsNativeType2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <FrameLayout
        android:id="@+id/frAdsNativeType2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/size3"
        android:layout_marginBottom="@dimen/size3"
        app:layout_constraintBottom_toBottomOf="parent">

        <include
            android:id="@+id/shimmerContainerNative2"
            layout="@layout/loading_native_ad_view_type2" />
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>