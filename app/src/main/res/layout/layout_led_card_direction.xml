<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardDirection"
    style="@style/Widget.App.CardContainer">

    <TextView
        style="@style/Widget.App.CardTitle"
        android:text="@string/direction" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center"
        android:orientation="horizontal">

        <FrameLayout
            android:id="@+id/btnDirectionRight"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_mode_card_unselected"
            android:clickable="true"
            android:focusable="true">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/imgDirectionRight"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_direction_right"
                app:tint="#8C8C8C" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/btnDirectionLeft"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginHorizontal="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_mode_card_selected"
            android:clickable="true"
            android:focusable="true">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/imgDirectionLeft"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_direction_left"
                app:tint="@color/color_main" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/btnDirectionDown"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginHorizontal="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_mode_card_unselected"
            android:clickable="true"
            android:focusable="true">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/imgDirectionDown"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_direction_down"
                app:tint="#8C8C8C" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/btnDirectionUp"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_mode_card_unselected"
            android:clickable="true"
            android:focusable="true">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/imgDirectionUp"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_direction_up"
                app:tint="#8C8C8C" />
        </FrameLayout>

    </LinearLayout>

</LinearLayout>