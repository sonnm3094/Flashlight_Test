<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_main"
    android:orientation="vertical">

    <include
        android:id="@+id/toolBar"
        layout="@layout/tool_bar" />

    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/lottieView"
        android:visibility="gone"
        android:layout_width="@dimen/size80"
        android:layout_height="@dimen/size52"
        android:layout_marginTop="@dimen/size60"
        android:elevation="1dp"
        app:layout_constraintEnd_toEndOf="@+id/toolBar"
        app:layout_constraintTop_toTopOf="@+id/toolBar"
        app:lottie_autoPlay="true"
        app:lottie_loop="true"
        app:lottie_rawRes="@raw/finger" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rcvLanguage"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingBottom="@dimen/size15"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolBar"
        tools:listitem="@layout/item_language" />

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="@dimen/size30"
        android:layout_height="@dimen/size30"
        android:layout_marginEnd="@dimen/size15"
        android:layout_marginBottom="@dimen/size6"
        android:indeterminate="true"
        android:indeterminateTint="@color/color_main"
        android:progressTint="@color/color_main"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@+id/rcvLanguage"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
