<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_main">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/toolBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:paddingHorizontal="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/led_title"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold"
            app:fontFamily="@font/plus_jakarta_sans_bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolBar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="24dp">

            <include
                android:id="@+id/layoutLedPreview"
                layout="@layout/layout_led_preview_card" />

            <include
                android:id="@+id/layoutLedText"
                layout="@layout/layout_led_card_text" />

            <LinearLayout
                android:id="@+id/cardFontAndSpeed"
                style="@style/Widget.App.CardContainer">

                <com.af.pb.component.common.view.SliderCardView
                    android:id="@+id/cardFontSize"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:sliderTitle="@string/font_size"
                    app:sliderUnit="px"
                    app:sliderMin="16"
                    app:sliderMax="120"
                    app:sliderValue="64" />

                <com.af.pb.component.common.view.SliderCardView
                    android:id="@+id/cardScrollSpeed"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    app:sliderTitle="@string/scroll_speed"
                    app:sliderUnit="s"
                    app:sliderMin="1"
                    app:sliderMax="10"
                    app:sliderValue="5" />

            </LinearLayout>

            <com.af.pb.component.common.view.ColorPickerCardView
                android:id="@+id/cardColor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp" />

            <include
                android:id="@+id/layoutLedDirection"
                layout="@layout/layout_led_card_direction" />

            <include
                android:id="@+id/layoutLedVisualEffects"
                layout="@layout/layout_led_card_visual_effects" />

            <include
                android:id="@+id/layoutLedBackground"
                layout="@layout/layout_led_card_background" />

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>