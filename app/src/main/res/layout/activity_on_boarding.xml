<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_main">

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/vpOnBoarding"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.0" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnNext"
        style="@style/StylePurpleButton"
        android:layout_width="wrap_content"
        android:layout_marginBottom="@dimen/size10"
        android:includeFontPadding="false"
        android:paddingHorizontal="@dimen/size20"
        app:fontFamily="@font/google_sans_medium"
        android:text="@string/next"
        app:layout_constraintBottom_toTopOf="@+id/frAdsNative"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.tbuonomo.viewpagerdotsindicator.DotsIndicator
        android:id="@+id/dots_indicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/size15"
        app:dotsColor="@color/gray"
        app:dotsCornerRadius="8dp"
        app:dotsSize="10dp"
        app:dotsSpacing="4dp"
        app:dotsWidthFactor="1"
        app:layout_constraintBottom_toBottomOf="@+id/btnNext"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/btnNext"
        app:progressMode="false"
        app:selectedDotColor="@color/purple" />

    <FrameLayout
        android:id="@+id/frAdsNative"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/size3"
        android:layout_marginBottom="@dimen/size3"
        app:layout_constraintBottom_toBottomOf="parent">

        <include
            android:id="@+id/shimmerContainerNative"
            layout="@layout/loading_native_ad_view_type1" />
    </FrameLayout>

    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/btnClose"
        style="@style/Widget.AppCompat.Button.Borderless"
        android:layout_width="@dimen/size40"
        android:layout_height="@dimen/size40"
        android:layout_marginStart="@dimen/size10"
        android:layout_marginTop="@dimen/size28"
        android:background="@drawable/background_circle_button_selector"
        android:src="@drawable/ic_close_2"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvCountDown"
        android:layout_width="@dimen/size28"
        android:layout_height="@dimen/size28"
        android:layout_marginStart="@dimen/size16"
        android:layout_marginTop="@dimen/size34"
        android:background="@drawable/background_count_down"
        android:gravity="center"
        android:text="5"
        android:textColor="@color/white"
        android:textSize="@dimen/size17"
        android:visibility="gone"
        app:fontFamily="@font/google_sans_semi_bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>

